# Dev-only seed scripts (contain env-var usage, not needed in production)
**/scripts/seed-*.mjs


# Large binaries — distributed via Supabase Storage, never committed
*.exe
node_modules/

# archive/ — frozen sub-apps and design assets, never built.
# Binary and image trees stay out of git; source and configs are tracked.
archive/seed-assets/
archive/design/
archive/design-system/
archive/mockups/
archive/logos/

# Post-monorepo-move: de-anchored equivalents of the root-anchored rules
# above, so build output and dev-only scripts stay ignored under apps/web/.
.next/
out/
coverage/
